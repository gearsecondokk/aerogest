{
  "name": "fal-video-telegram-bot",
  "version": "0.1.0",
  "description": "Bot Telegram qui génère des vidéos IA (image → vidéo) via fal.ai, avec assistant de prompt Claude et estimation des coûts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fal-ai/client": "^1.10.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
