# Token du bot Telegram (obtenu via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...

# Clé API fal.ai (https://fal.ai/dashboard/keys)
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé API Anthropic pour l'assistant de prompt (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Modèle Claude qui discute avec toi dans Telegram
CLAUDE_MODEL=claude-opus-5
# Profondeur de réflexion : low | medium | high | xhigh | max (medium = réactif et économique)
CLAUDE_EFFORT=medium
# Nombre de messages d'historique conservés par conversation
HISTORY_MAX_MESSAGES=40

# IDs Telegram autorisés à utiliser le bot (séparés par des virgules).
# Vide = tout le monde (déconseillé : chaque vidéo coûte de l'argent). Utilise /id pour connaître ton ID.
ALLOWED_USER_IDS=

# Garde-fous de dépenses (en USD)
MAX_COST_PER_VIDEO_USD=5
# Plafond du TOTAL d'un duel. Appliquer la limite par vidéo à la somme
# interdirait de comparer les modèles haut de gamme — l'objet même d'un duel.
# Défaut si absent : 4x le plafond unitaire.
MAX_COST_PER_DUEL_USD=6
# DAILY_BUDGET_USD=20

# Divers
DATA_DIR=./data
POLL_INTERVAL_MS=5000

# Clé API BytePlus ModelArk (https://console.byteplus.com — section API Keys).
# Sans elle, les modèles Seedance sont indisponibles. Pense à ACTIVER chaque
# modèle dans la console : une clé valide ne suffit pas (erreur ModelNotOpen).
BYTEPLUS_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxx

# Chats où le bot a le droit de répondre (ids séparés par des virgules).
# Vide = partout. Un id de groupe est négatif. /id donne l'id du chat.
ALLOWED_CHAT_IDS=
